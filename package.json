{
  "name": "voila-framework",
  "version": "1.0.0",
  "description": "Voila Framework - Monolithic-to-microservices framework for agentic development",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev:api": "nodemon --watch src --ext ts --exec \"tsx\" src/server.ts",
    "server": "npx tsx scripts/voila-server.ts",
    "build": "npm run build:api",
    "build:api": "tsc -p tsconfig.api.json",
    "start": "node dist/server.js",
    "test": "npx tsx scripts/voila-test.ts",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "validate": "npx tsx scripts/voila-validate.ts",
    "generate": "npx tsx scripts/voila-generate.ts",
    "plan": "npx tsx scripts/voila-plan.ts",
    "context": "npx tsx scripts/voila-context.ts",
    "routes": "npx tsx scripts/voila-routes.ts",
    "help": "npx tsx scripts/voila-help.ts",
    "git": "npx tsx scripts/voila-git.ts",
    "deploy": "npx tsx scripts/voila-deploy.ts"
  },
  "keywords": [
    "voila",
    "framework",
    "monolithic",
    "microservices",
    "agentic",
    "typescript",
    "react"
  ],
  "author": "Voila Team",
  "license": "MIT",
  "dependencies": {
    "@voilajsx/appkit": "github:voilajsx/appkit",
    "dotenv": "^17.2.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "yaml": "^2.8.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.16",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^3.2.4",
    "antd": "^5.12.8",
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^23.0.1",
    "nodemon": "^3.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1",
    "rimraf": "^5.0.5",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.1",
    "tsx": "^4.20.4",
    "typescript": "^5.3.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
