{
  "name": "voila-framework",
  "version": "1.0.0",
  "description": "Voila Framework - Monolithic-to-microservices framework for agentic development",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "npx tsx scripts/voila-server.ts dev:both",
    "dev:api": "npx tsx scripts/voila-server.ts dev:api",
    "dev:web": "npx tsx scripts/voila-server.ts dev:web",
    "server": "npx tsx scripts/voila-server.ts",
    "build": "npm run build:web && npm run build:api",
    "build:api": "tsc -p tsconfig.api.json && tsc-alias -p tsconfig.api.json && npm run build:prisma",
    "build:web": "vite build",
    "build:themes": "npx voila-bundle",
    "start": "node dist/server.js",
    "preview": "npm run build && npm run start",
    "test": "npx tsx scripts/voila-test.ts",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.api.json",
    "clean": "rimraf dist",
    "validate": "npx tsx scripts/voila-validate.ts",
    "validate:web": "npx tsx -e \"import('./src/lib/web-discovery.js').then(c => c.validateAllWebApps('./src/web'))\"",
    "generate": "npx tsx scripts/voila-generate.ts",
    "plan": "npx tsx scripts/voila-plan.ts",
    "context": "npx tsx scripts/voila-context.ts",
    "routes": "npx tsx scripts/voila-routes.ts",
    "doc": "npx tsx scripts/voila-doc.ts",
    "help": "npx tsx scripts/voila-help.ts",
    "git": "npx tsx scripts/voila-git.ts",
    "deploy": "npx tsx scripts/voila-deploy.ts",
    "prisma": "npx tsx scripts/voila-prisma.ts",
    "build:prisma": "find src/api -name 'schema.prisma' -exec dirname {} \\; | while read schema_dir; do npx prisma generate --schema=\"$schema_dir/schema.prisma\"; done && find src/api -path '*/prisma/generated' -exec sh -c 'dist_dir=\"dist/api/$(echo \"$1\" | sed \"s|src/api/||\" | cut -d/ -f1)/prisma\"; mkdir -p \"$dist_dir\"; cp -r \"$1\" \"$dist_dir/\"' _ {} \\;"
  },
  "keywords": [
    "voila",
    "framework",
    "monolithic",
    "microservices",
    "agentic",
    "typescript",
    "react"
  ],
  "author": "Voila Team",
  "license": "MIT",
  "dependencies": {
    "@playwright/test": "^1.55.0",
    "@prisma/client": "^5.0.0",
    "@voilajsx/appkit": "github:voilajsx/appkit",
    "@voilajsx/uikit": "github:voilajsx/uikitv2",
    "commander": "^14.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "http-proxy-middleware": "^3.0.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1",
    "yaml": "^2.8.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.85.6",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.16",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^3.2.4",
    "antd": "^5.12.8",
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^23.2.0",
    "nodemon": "^3.0.2",
    "prisma": "^5.0.0",
    "rimraf": "^5.0.5",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.4",
    "typedoc": "^0.28.12",
    "typescript": "^5.3.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
