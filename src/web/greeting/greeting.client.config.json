{
  "app": "greeting",
  "client": {
    "api": {
      "development": {
        "baseUrl": "http://localhost:8000/api/greeting",
        "timeout": 10000,
        "retries": 2,
        "cache": {
          "enabled": true,
          "duration": 300000,
          "strategy": "memory"
        },
        "headers": {
          "X-Client": "voila-web",
          "X-Environment": "development"
        }
      },
      "staging": {
        "baseUrl": "https://staging-api.voila.com/api/greeting",
        "timeout": 15000,
        "retries": 3,
        "cache": {
          "enabled": true,
          "duration": 600000,
          "strategy": "memory"
        },
        "headers": {
          "X-Client": "voila-web",
          "X-Environment": "staging"
        }
      },
      "production": {
        "baseUrl": "https://api.voila.com/api/greeting",
        "timeout": 20000,
        "retries": 3,
        "cache": {
          "enabled": true,
          "duration": 900000,
          "strategy": "localStorage"
        },
        "headers": {
          "X-Client": "voila-web",
          "X-Environment": "production"
        }
      },
      "local-microservice": {
        "baseUrl": "http://localhost:3001/api",
        "timeout": 5000,
        "retries": 1,
        "cache": {
          "enabled": false,
          "duration": 0,
          "strategy": "memory"
        },
        "headers": {
          "X-Client": "voila-web",
          "X-Environment": "local-microservice"
        }
      }
    },
    "ui": {
      "theme": "default",
      "language": "en",
      "autoRefresh": true,
      "debounceMs": 300
    }
  },
  "metadata": {
    "owner": "Frontend Team",
    "created": "2025-08-28",
    "version": "2.0.0"
  }
}