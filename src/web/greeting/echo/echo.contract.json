{
  "feature": "echo",
  "app": "greeting",
  "version": "1.0.0",
  "last_updated": "2025-01-20T10:00:00Z",
  
  "ui": {
    "base_path": "/app/greeting",
    "routes": [
      {
        "path": "/echo",
        "component": "EchoPage",
        "description": "Echo page for message input",
        "auth_required": false
      },
      {
        "path": "/echo/:message",
        "component": "EchoPage",
        "description": "Echo page with pre-filled message",
        "auth_required": false
      }
    ]
  },

  "components": {
    "EchoPage": {
      "props": {
        "message": "string (optional)"
      },
      "state": {
        "message": "string",
        "echoResponse": "EchoData | null",
        "loading": "boolean",
        "error": "string | null",
        "method": "'POST' | 'GET'"
      }
    }
  },

  "services": {
    "EchoService": {
      "echoMessage": {
        "params": {
          "message": "string"
        },
        "returns": "EchoResponse",
        "endpoint": "POST /api/greeting/echo"
      },
      "echoMessageGet": {
        "params": {
          "message": "string"
        },
        "returns": "EchoResponse",
        "endpoint": "GET /api/greeting/echo/:message"
      }
    }
  },

  "models": {
    "EchoRequest": {
      "message": "string"
    },
    "EchoData": {
      "original_message": "string",
      "echoed_message": "string",
      "message_length": "number",
      "timestamp": "string",
      "requestId": "string",
      "feature": "string",
      "method": "string"
    },
    "EchoResponse": {
      "success": "boolean",
      "data": "EchoData"
    },
    "EchoComponentState": {
      "message": "string",
      "echoResponse": "EchoData | null",
      "loading": "boolean",
      "error": "string | null",
      "method": "'POST' | 'GET'"
    }
  },

  "dependencies": {
    "api": ["greeting/echo"],
    "frontend": [],
    "ui_components": ["Card", "Button", "Input", "Typography", "Space", "Spin", "Alert", "Radio"]
  },

  "authentication": {
    "type": "none",
    "note": "Public echo feature requires no authentication"
  },

  "reliability": {
    "test_coverage": 85,
    "type_safety": 100,
