{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@web/*": ["src/web/*"],
      "@lib/*": ["src/lib/*"],
      "@api/*": ["src/api/*"],
      "@styles/*": ["src/web/assets/styles/*"]
    }
  },
  "include": [
    "src/web/**/*",
    "src/lib/web-*.tsx",
    "src/lib/web-*.ts"
  ],
  "exclude": [
    "src/api/**/*",
    "src/server.ts",
    "src/lib/web-discovery.ts",
    "node_modules"
  ]
}