# Server Configuration
PORT=8000
NODE_ENV=development

# Database (if needed later)
# DATABASE_URL=postgresql://user:password@localhost:5432/voila

# VoilaJSX AppKit Auth Configuration
VOILA_AUTH_SECRET=your-super-secure-jwt-secret-key-minimum-32-chars-change-in-production

# AppKit Security Configuration  
VOILA_SECURITY_CSRF_SECRET=your-csrf-secret-key-minimum-32-chars-change-in-production
VOILA_SECURITY_ENCRYPTION_KEY=64-char-hex-encryption-key-for-aes256-change-in-production

# Legacy JWT (if needed for other services)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# Logging
LOG_LEVEL=info

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100