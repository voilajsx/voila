{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "jsx": "preserve"
  },
  "include": [
    "src/api/**/*",
    "src/server.ts",
    "src/lib/**/*",
    "src/config/**/*",
    "src/middleware/**/*",
    "src/utils/**/*"
  ],
  "exclude": [
    "src/app/**/*",
    "node_modules",
    "**/*.test.ts"
  ]
}